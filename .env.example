# ── WordPress ──────────────────────────────────────────────────────────────────
WORDPRESS_URL=https://ejemplo.com
WORDPRESS_USER=usuario
WORDPRESS_PASSWORD=contraseña

# ── Base de Datos (PostgreSQL) ─────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost/neurodiario

# ── Anthropic / Claude ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Alias alternativo (también soportado)
CLAUDE_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-4-6

# ── Aplicación ─────────────────────────────────────────────────────────────────
DEBUG=False
LOG_LEVEL=INFO
TIMEZONE=America/Santo_Domingo

# ── Pipeline ───────────────────────────────────────────────────────────────────
FETCH_INTERVAL_HOURS=2
MAX_ARTICLES_PER_CYCLE=100
TREND_WINDOW_HOURS=24
INGESTION_INTERVAL_MINUTES=15
NLP_INTERVAL_MINUTES=20

# ── NLP ────────────────────────────────────────────────────────────────────────
SPACY_MODEL=es_core_news_lg

# ── WhatsApp / WAHA ──────────────────────────────────────────────────────────
# El número de esta sesión debe ser OWNER o ADMIN del canal.
# Activar solo después de comprobar la conexión desde el contenedor NeuroDiario.
WHATSAPP_ENABLED=false
WAHA_URL=http://universidad-waha-1:3000
WAHA_API_KEY=
WAHA_SESSION=default
WHATSAPP_CHANNEL_ID=120363412361118712@newsletter
# Fecha inicial explícita para no reenviar todo el histórico. ISO con zona horaria.
# Ejemplo: 2026-10-22T00:00:00Z
WHATSAPP_START_AT=

