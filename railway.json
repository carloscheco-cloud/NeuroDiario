{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install -r requirements.txt && python -m spacy download es_core_news_lg"
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "python -m neurodiario.scheduler.auto_scheduler",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
